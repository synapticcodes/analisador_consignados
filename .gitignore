# ==============================================
# Calculadora de Consignados - .gitignore
# ==============================================

# ==============================================
# Environment Variables
# ==============================================
.env
.env.local
.env.*.local
.env.development
.env.production

# ==============================================
# Python
# ==============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv
backend/venv/
backend/env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage/
.nyc_output/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Linters
.ruff_cache/

# ==============================================
# Node / JavaScript / TypeScript
# ==============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log

# Next.js
.next/
out/
build/
dist/
.turbo/

# Production
/build
/dist

# ==============================================
# IDEs and Editors
# ==============================================
# VSCode
.vscode/
*.code-workspace

# IntelliJ IDEA / PyCharm
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ==============================================
# Operating System
# ==============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ==============================================
# Docker
# ==============================================
# Ignorar volumes locais (se criados fora do docker-compose)
postgres_data/
redis_data/
qdrant_data/
minio_data/

# ==============================================
# Logs
# ==============================================
*.log
logs/
*.log.*

# ==============================================
# Database
# ==============================================
*.db
*.sqlite
*.sqlite3

# ==============================================
# Temporary Files
# ==============================================
tmp/
temp/
*.tmp
*.temp
.cache/

# ==============================================
# Security & Secrets
# ==============================================
*.pem
*.key
*.crt
secrets/
.secrets/

# ==============================================
# CI/CD
# ==============================================
.github/workflows/*.yml.bak

# ==============================================
# Documentation Build
# ==============================================
docs/_build/
docs/.doctrees/
site/

# ==============================================
# Alembic
# ==============================================
# Manter apenas versions/, ignorar arquivos gerados
alembic/versions/__pycache__/

# ==============================================
# Testing & Coverage
# ==============================================
.pytest_cache/
.coverage
htmlcov/
junit.xml
test-results/

# ==============================================
# Misc
# ==============================================
.vercel
*.bak
*.orig
backend/storage/
