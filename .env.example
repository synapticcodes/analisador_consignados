# ==============================================
# Calculadora de Consignados - Environment Variables
# ==============================================
# Uso:
# 1) cp .env.example .env
# 2) Preencher principalmente OPENAI_API_KEY e SECRET_KEY

# ==============================================
# Credenciais base de infraestrutura (Docker)
# ==============================================
POSTGRES_PASSWORD=postgres_dev_password
REDIS_PASSWORD=redis_dev_password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
QDRANT_API_KEY=

# ==============================================
# OpenAI (OBRIGATORIO para extracao completa)
# ==============================================
# Gere em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-coloque-sua-chave-aqui
OPENAI_MODEL=gpt-4o

# ==============================================
# AWS Textract (opcional)
# ==============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ==============================================
# Aplicacao backend
# ==============================================
ENVIRONMENT=development
DEBUG=true
# Minimo 32 caracteres
SECRET_KEY=change_this_secret_key_min_32_chars_123

# CORS (base + v2)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ALLOWED_ORIGINS_V2=http://localhost:3001,http://localhost:3002

# ==============================================
# Feature Flags - Relatorio PDF v2
# ==============================================
FEATURE_PDF_V2_ENABLED=true
FEATURE_PDF_V2_PHASE2_ENABLED=true
FEATURE_PDF_V2_PHASE3_ENABLED=true
TAXA_REFERENCIA_MENSAL=1.50

# ==============================================
# Frontend base (porta 3000 -> backend 8000)
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_FEATURE_PDF_V2_ENABLED=true
NEXT_PUBLIC_FEATURE_PDF_V2_PHASE2_ENABLED=true
NEXT_PUBLIC_FEATURE_PDF_V2_PHASE3_ENABLED=true

# Frontend v2 (porta 3001 -> backend 8001)
NEXT_PUBLIC_API_URL_V2=http://localhost:8001
NEXT_PUBLIC_WS_URL_V2=ws://localhost:8001

# ==============================================
# Observabilidade (opcional)
# ==============================================
SENTRY_DSN=
