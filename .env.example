# ==============================================
# Calculadora de Consignados - Environment Variables
# ==============================================
# Copie este arquivo para .env e preencha com suas credenciais

# ==============================================
# Database (PostgreSQL 18)
# ==============================================
POSTGRES_PASSWORD=postgres_dev_password

# ==============================================
# Redis (Cache & Queue)
# ==============================================
REDIS_PASSWORD=redis_dev_password

# ==============================================
# MinIO (S3-compatible Storage)
# ==============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ==============================================
# Qdrant (Vector Database)
# ==============================================
QDRANT_API_KEY=

# ==============================================
# OpenAI API (OBRIGATÓRIO)
# ==============================================
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o

# ==============================================
# AWS Textract (OCR Fallback - OPCIONAL)
# ==============================================
# Deixe em branco se não for usar OCR
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ==============================================
# Application Settings
# ==============================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change_this_secret_key_in_production_min_32_chars

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ==============================================
# Frontend (Next.js)
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ==============================================
# Celery (Background Tasks)
# ==============================================
# Configurado automaticamente via Redis

# ==============================================
# Monitoring & Observability (Fase 2)
# ==============================================
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false

# ==============================================
# Production Settings
# ==============================================
# Descomente e configure para produção:
# ENVIRONMENT=production
# DEBUG=false
# SECRET_KEY=use_strong_random_key_min_32_chars
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
# REDIS_URL=redis://:pass@host:6379/0
# S3_ENDPOINT=https://s3.amazonaws.com
# ALLOWED_ORIGINS=https://yourdomain.com
